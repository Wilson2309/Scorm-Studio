AI_PROVIDER=ollama
# Supabase public configuration; obtain locally from your project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact application origin used for email confirmation and recovery redirects.
APP_URL=http://localhost:3000
# Server-only, 32 random bytes encoded as 64 lowercase hex characters. Never NEXT_PUBLIC.
# Seals canonical preparation against direct owner-API tampering; retain across restarts.
WORKSPACE_SIGNING_KEY=
AI_BASE_URL=http://127.0.0.1:11435
AI_MODEL=qwen3:4b-instruct
AI_FALLBACK_MODEL=qwen2.5:3b
AI_TIMEOUT_MS=600000
AI_HEALTH_TIMEOUT_MS=5000
AI_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
# Legacy AI_NUM_CTX is used only when OLLAMA_NUM_CTX is absent.
OLLAMA_KEEP_ALIVE=10m
# Lean question wording only; larger operations retain OLLAMA_NUM_CTX.
OLLAMA_LEAN_NUM_CTX=4096
# Five-question output ceiling; scales with requested count (minimum 256).
AI_LEAN_MAX_TOKENS=900
# Optional budgets (defaults shown):
# AI_MAX_INPUT_CHARS=24000
# AI_ANALYSIS_MAX_TOKENS=1800
# AI_QUIZ_MAX_TOKENS=3000

# Not required or sent by Ollama. Keep empty in this template.
AI_API_KEY=
AI_APP_NAME=SCORM Studio
AI_HTTP_REFERER=http://localhost:3000

# Alternative: OpenRouter (configure real key privately in .env.local).
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemma-4-26b-a4b-it:free
# AI_FALLBACK_MODEL=google/gemma-4-31b-it:free
# Gemma JSON mode remains enforced by the adapter.

# Same-VPS production only (no SSH tunnel):
# AI_BASE_URL=http://127.0.0.1:11434
